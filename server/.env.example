# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/news_site?schema=public"

# Auth
JWT_ACCESS_SECRET="your-access-secret-min-16-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-16-chars"
AUTOMATION_API_KEY="your-automation-key"

# App
CLIENT_URL="http://localhost:5173"
PORT=4000
NODE_ENV=development

# Payment mode: mock | portone_test | portone_live
PAYMENT_MODE=mock
# 결제 테스트 UI 허용 아이디 (기본으로 username `admin` 은 코드에서 허용).
# PAYMENT_TEST_USERNAMES=
# PortOne (portone_test / portone_live 에서 필요)
# PORTONE_IMP_CODE=
# PORTONE_API_KEY=
# PORTONE_API_SECRET=
# PORTONE_KAKAO_CHANNEL_KEY=
# PORTONE_TOSS_CHANNEL_KEY=        # 토스페이 (tosspay_v2) 테스트/운영 채널
# PORTONE_NAVER_CHANNEL_KEY=       # (보류) 네이버페이
# PORTONE_ACCOUNT_CHANNEL_KEY=   # (보류) 헥토파이낸셜 내통장결제
# PORTONE_KAKAO_PG=kakaopay.TCSUBSCRIP
# PORTONE_TOSS_PG=tosspay_v2
# PORTONE_NAVER_PG=naverpay
# PORTONE_ACCOUNT_PG=settle_acc
# PORTONE_PHONE_CHANNEL_KEY=     # (중단) 다날 휴대폰 — 가입비 20만원
# PORTONE_PG=danal
# API_PUBLIC_URL=https://api.example.com
# 웹훅·자동화 업로드 응답의 공개 절대 URL 오리진 (운영 권장)

# OAuth (optional)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_REDIRECT_URI=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
